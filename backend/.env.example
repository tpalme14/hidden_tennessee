DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landmarks_dev"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/landmarks_test"
PORT=3000
NODE_ENV=development

# Better Auth (M03-T02). Required in every environment. Generate a secret with
#   node -p "require('crypto').randomBytes(32).toString('base64url')"
# and keep the real value only in the git-ignored .env file.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TELEMETRY=0

# Rate limiting (M03-T02 Increment 5). Enabled automatically when
# NODE_ENV=production; set "true" to turn it on elsewhere.
AUTH_RATE_LIMIT_ENABLED=
# Reverse-proxy hops whose X-Forwarded-For entries are trusted (Express
# "trust proxy"). Keep 0 until the deployed proxy chain has been verified with
# a deliberately spoofed X-Forwarded-For — see backend/src/auth/client-ip.ts.
AUTH_TRUSTED_PROXY_HOPS=0

# Password-reset email (M03-T02 Increment 6). "smtp" or "disabled"; production
# must choose explicitly. With "disabled", reset requests answer 503 safely.
MAIL_TRANSPORT=disabled
# Required only for smtp. SMTP_URL carries the credentials — keep it in the
# ignored .env only, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
# Verified sender identity (deployment decision), e.g. "Landmarks <no-reply@example.com>"
MAIL_FROM=
