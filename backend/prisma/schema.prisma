// Skeleton schema for M00-T04. No models yet — Landmark (M01-T02) and
// User/Session/Account (M03-T01, via Better Auth's Prisma adapter) are added
// in their respective milestones.
//
// PostGIS is deliberately NOT declared via the `postgresqlExtensions`
// preview feature / datasource `extensions = [postgis]` syntax: that feature
// was deprecated in Prisma ORM 6.16.0. Per Prisma's current documented
// guidance, PostGIS will instead be enabled via a customized migration
// (`CREATE EXTENSION IF NOT EXISTS postgis;` as raw SQL) when the first real
// migration is created in M01-T03. Geometry/geography columns remain
// `Unsupported(...)` types queried via parameterized raw SQL, consistent
// with ADR-003.
//
// Prisma ORM 7 moved the connection URL out of this file's datasource block
// (verified against current Prisma docs; `url = env(...)` here is rejected
// at schema-validation time) and into `prisma.config.ts`, with `PrismaClient`
// now requiring an explicit driver adapter (`@prisma/adapter-pg` for
// PostgreSQL) rather than reading `datasource.url` implicitly at runtime.
// See `prisma.config.ts` and `src/db/prisma.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Landmark data model, per M01-T02 (docs/IMPLEMENTATION_PLAN.md).
//
// `location` is declared `Unsupported` because it is a database-generated
// column (`GENERATED ALWAYS AS (...) STORED`, computed from latitude/
// longitude) — Prisma's schema language has no syntax for the GENERATED
// modifier, so the real column definition is hand-written into the
// migration SQL (see prisma/migrations/) rather than derived from this
// declaration. Because the type is Unsupported, Prisma Client omits this
// field entirely from generated types, so no application code path can
// attempt to write to it directly; only raw SQL reads are possible, and
// only the database itself (via the generated-column expression) ever
// writes to it.
//
// CHECK constraints (latitude/longitude range, source_code format) and the
// GiST spatial index on `location` are likewise hand-written into the
// migration SQL, since Prisma's schema language has no declarative syntax
// for either.

enum LandmarkCategory {
  ARCH
  BALD
  FALLS
  LAKE
  OTHER
  PEAK
  ROCK
  SINK
}

enum LandmarkSourceFile {
  TNARCHES
  TNBALDS
  TNFALLS
  TNLAKES
  TNOTHER
  TNPEAKS
  TNROCKS
  TNSINKS
}

enum SensitivityReviewStatus {
  UNREVIEWED
  PUBLIC
  SENSITIVE
}

model Landmark {
  id                String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCode        String                                @unique @map("source_code")
  sourceFile        LandmarkSourceFile                    @map("source_file")
  category          LandmarkCategory
  displayName       String                                @map("display_name")
  latitude          Float
  longitude         Float
  location          Unsupported("geography(Point,4326)")? @default(dbgenerated())
  sourceDescription String?                               @map("source_description")
  sourceAccessLabel String?                               @map("source_access_label")
  sourceUrl         String?                               @map("source_url")
  isActive          Boolean                               @default(true) @map("is_active")
  sensitivityStatus SensitivityReviewStatus               @default(UNREVIEWED) @map("sensitivity_status")
  createdAt         DateTime                              @default(now()) @map("created_at")
  updatedAt         DateTime                              @updatedAt @map("updated_at")

  @@map("landmarks")
}

// Identity data model, per M03-T01 / ADR-011 (docs/DECISIONS.md).
//
// `User`, `Session`, `Account`, and `Verification` carry exactly Better Auth
// 1.7.18's core field set (packages/core/src/db/get-tables.ts at tag v1.7.18)
// so the library's startup schema validation passes, hand-authored here under
// the project's own conventions rather than generated by the Better Auth CLI:
// snake_case columns via @map, plural snake_case tables via @@map, and
// database-generated UUID primary keys (Better Auth is configured with
// `advanced.database.generateId: false`, so inserts omit `id`). Better Auth's
// Prisma adapter addresses Prisma models/fields through the generated client,
// so no `modelName`/`fields` remapping is needed on the library side.
//
// Cascade from `users` is confined to Better Auth's own `sessions` and
// `accounts`. Every application relationship to `users` (favorites in M03-T05,
// reviews, trips) uses RESTRICT, per spec §10.2.6 and ADR-011 decision 7.
//
// Two integrity rules Prisma cannot express declaratively are hand-written
// into the migration SQL (same pattern as the `landmarks` CHECK constraints):
//   - a unique index on lower("email") on `users` (case-insensitive
//     uniqueness, independent of the library's own lowercasing), and
//   - a partial unique index on `accounts`("user_id") WHERE provider_id =
//     'credential' (one credential account per user, stated directly).
//
// `ip_address` and `user_agent` stay as nullable columns for schema
// compatibility; the application's session-creation hook blanks them
// (ADR-011 decision 4). The OAuth token columns on `accounts` are never
// populated (no OAuth providers) but must exist for schema validation.

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// Better Auth's database-backed rate-limit storage (model name `rateLimit`:
// unique `key`, `count`, `lastRequest` epoch-ms), approved for M03-T02 and
// recorded as an ADR-011 amendment. Rows are never deleted by the library;
// retention is handled by the recorded maintenance follow-up.
model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}
